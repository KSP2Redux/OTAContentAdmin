APP_NAME="Redux OTA Admin"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://ota-admin.rendezvous.dev

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

AUTHENTIK_ISSUER=https://sso.rendezvous.dev/application/o/redux-ota-admin/
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_REDIRECT_URI=https://ota-admin.rendezvous.dev/auth/callback
AUTHENTIK_PUBLISHER_GROUP="Rendezvous Entertainment Content Managers"

GITHUB_CONTENT_OWNER=KSP2Redux
GITHUB_CONTENT_REPO=Content
GITHUB_CONTENT_BRANCH=main
GITHUB_CONTENT_RAW_URL=https://raw.githubusercontent.com/KSP2Redux/Content/main
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=

WEBLATE_URL=https://translate.rendezvous.dev/api
WEBLATE_WEB_URL=https://translate.rendezvous.dev
WEBLATE_TOKEN=
WEBLATE_PROJECT=ksp2redux
WEBLATE_MISSIONS_COMPONENT=missions
WEBLATE_TIMEOUT_SECONDS=600

GITLAB_URL=https://git.rendezvous.dev/api/v4
GITLAB_TOKEN=
GITLAB_PROJECT_ID=9
GITLAB_OTA_REF=develop
GITLAB_OTA_JOB=publish-ota-content
GITLAB_TIMEOUT_SECONDS=1800

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
